# Copy to .env and fill in. Blank optional values are treated as unset.

# ==================================
# APP
# ==================================

# At least 32 characters. Generate a unique value with: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_ME

# Public origin of the app (no trailing slash). Used for absolute URLs, CORS and CSRF.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000


# ==================================
# DATABASE
# ==================================

DATABASE_URL=postgresql://payload:payload-local@127.0.0.1:5432/app


# ==================================
# STORAGE (optional)
# ==================================
# Leave blank to store uploads in ./media. Setting bucket, region and both keys switches
# uploads to S3-compatible storage (AWS S3, Cloudflare R2, MinIO, SeaweedFS, ...).

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Defaults to true when S3_ENDPOINT is set.
S3_FORCE_PATH_STYLE=


# ==================================
# EMAIL (optional)
# ==================================
# Leave SMTP_HOST blank to print emails to the console.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to true on port 465.
SMTP_SECURE=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Payload


# ==================================
# SEED (optional, used by `pnpm seed`)
# ==================================

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
